{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "my-vault-manager",
  "title": "My Vault Manager",
  "description": "Vault extension for Raycast with support for multiple Vault instances",
  "icon": "vault.png",
  "author": "fonimus",
  "contributors": [
    "ricoberger",
    "pernielsentikaer"
  ],
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "vault",
      "title": "Vault Manager",
      "subtitle": "Vault",
      "description": "Browse, view and manage secrets across your Vault instances",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "1.52.1",
    "@raycast/utils": "1.7.0",
    "got": "12.5.3",
    "human-date": "1.4.0",
    "node-vault": "0.9.22"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.5",
    "@types/human-date": "1.4.2",
    "@types/node": "18.14.2",
    "@types/react": "18.0.28",
    "eslint": "8.35.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "prettier": "2.8.4",
    "typescript": "4.9.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
